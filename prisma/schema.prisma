datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  OPERADOR
  LEITOR
}

enum VehicleKind {
  ONIBUS
  MICROONIBUS
  VAN
  UTILITARIO
}

enum VehicleStatus {
  ATIVO
  MANUTENCAO
  INATIVO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(OPERADOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  announcements Announcement[]
  financialEntries FinancialEntry[]
  auditLogs AuditLog[]
}

model Vehicle {
  id                 String   @id @default(cuid())
  plate              String   @unique
  label              String
  kind               VehicleKind
  capacity           Int
  odometerKm         Int
  status             VehicleStatus @default(ATIVO)
  nextInspectionDate DateTime
  driverName         String?
  schoolRouteName    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  trips               RouteTrip[]
  partMaintenances    PartMaintenance[]
  fuelLogs            FuelLog[]
  serviceMaintenances ServiceMaintenance[]
  gpsPoints           GpsPoint[]

  financialEntries FinancialEntry[]
}

model Student {
  id        String   @id @default(cuid())
  name      String
  birthDate DateTime? @db.Date
  guardianName String?
  guardianPhone String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financialEntries FinancialEntry[]

  @@index([active])
  @@index([name])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  pinned    Boolean  @default(false)
  publishedAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pinned, publishedAt])
}

enum FinancialEntryType {
  RECEITA
  DESPESA
}

model FinancialEntry {
  id        String   @id @default(cuid())
  type      FinancialEntryType
  date      DateTime @db.Date
  category  String
  amountBrl Decimal  @db.Decimal(12, 2)
  notes     String?

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, type])
  @@index([category])
  @@index([vehicleId])
  @@index([studentId])
  @@index([createdById])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action    String
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model RouteTrip {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startedAt  DateTime
  endedAt    DateTime
  distanceKm Float
  stops      Int
  routeName  String
  createdAt  DateTime @default(now())

  waypoints RouteWaypoint[]
}

model RouteWaypoint {
  id       String    @id @default(cuid())
  tripId   String
  trip     RouteTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lat      Float
  lng      Float
  orderIdx Int

  @@index([tripId])
}

model PartMaintenance {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  description String
  partName    String
  costBrl     Decimal  @db.Decimal(12, 2)
  odometerKm  Int
  createdAt   DateTime @default(now())
}

model FuelLog {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  liters     Float
  costBrl    Decimal  @db.Decimal(12, 2)
  odometerKm Int
  station    String?
  createdAt  DateTime @default(now())
}

model ServiceMaintenance {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  title      String
  notes      String?
  costBrl    Decimal  @db.Decimal(12, 2)
  odometerKm Int
  createdAt  DateTime @default(now())
}

model GpsPoint {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  recordedAt DateTime
  source     String?
  createdAt  DateTime @default(now())

  @@index([vehicleId, recordedAt])
}
