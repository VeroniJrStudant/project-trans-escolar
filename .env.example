# PostgreSQL
#   npm run db:up   (usa Compose se existir; senão sobe postgres:16 com `docker run`)
#   npx prisma migrate deploy
#   npm run db:seed
#
# Mac sem plugin "docker compose": o script db-up.sh usa só `docker run`.
# Se "Can't reach localhost:5432": rode db:up ou confira DATABASE_URL.
DATABASE_URL="postgresql://transescolar:transescolar@localhost:5432/transescolar?schema=public"

NEXTAUTH_URL="http://localhost:3000"
# Não deixe em branco (ex.: NEXTAUTH_SECRET=). Se omitir a variável em dev, um fallback local é usado.
NEXTAUTH_SECRET="troque-por-string-longa-aleatoria"

# Opcional: dispositivos / parceiro enviam pontos sem cookie de sessão
GPS_INGEST_API_KEY="troque-por-chave-secreta"

# Opcional: depuração NextAuth (evite em produção)
# NEXTAUTH_DEBUG=1

# Opcional: log de queries Prisma no terminal (dev)
# PRISMA_LOG_QUERIES=1
